lista_n3 = [6, 7, 7]

for i in range(3):
    n1 = lista_n1[i]
    n2 = lista_n2[i]
    n3 = lista_n3[i]
    
    print(f"\nInput: {n1}, {n2}, {n3}")
    
    sum_value = n1 + n2 + n3
    average_value = sum_value / 3.0
    
    # Maximo con puro if
    max_value = n1
    if n2 > max_value:
        max_value = n2
    if n3 > max_value:
        max_value = n3
        
    # Minimo con puro if
    min_value = n1
    if n2 < min_value:
        min_value = n2
    if n3 < min_value:
        min_value = n3
        
    print(f"Sum: {sum_value}")
    print(f"Average: {average_value}")
    print(f"Max: {max_value}")
    print(f"Min: {min_value}")
    
    # Verificar si son pares
    if n1 % 2 == 0 and n2 % 2 == 0 and n3 % 2 == 0:
