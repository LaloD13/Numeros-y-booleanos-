print("Problem 1: Temperature converter and range flag".upper())
"""Description: Convierte una temperatura de Celsius a Fahrenheit y Kelvin,
# e indica con un booleano si es una temperatura alta (>= 30.0°C).
"""
# Inputs:
# - temp_c (float o string que pueda convertirse a float)
#
# Outputs:
# - "Fahrenheit: <temp_f>"
# - "Kelvin: <temp_k>"
# - "High temperature: true|false"
#
# Validations:
# - Verificar que temp_c pueda convertirse a float.
# - No permitir temperaturas físicas imposibles (temp_k < 0.0).

temperaturas_prueba = [35.5, 20.0, -300.0]

for temp_c in temperaturas_prueba:
    print(f"\nInput: {temp_c}°C")
    
    temp_k = temp_c + 273.15
    
    if temp_k < 0.0:
        print("Error: invalid input")
    else:
        temp_f = temp_c * 9 / 5 + 32
        
        print(f"Fahrenheit: {temp_f}")
        print(f"Kelvin: {temp_k}")
        
        # Booleano básico con puro if/else
        if temp_c >= 30.0:
            print("High temperature: true")
        else:
            print("High temperature: false")

print("Problem 2: Work hours and overtime payment".upper())
"""Description: Calcula el pago semanal separando horas regulares (hasta 40)
# y horas extra (pagadas al 150%). Indica con un booleano si se trabajaron extras.
"""
# Inputs:
# - hours_worked (float)
# - hourly_rate (float)
#
# Outputs:
# - "Regular pay: <regular_pay>"
# - "Overtime pay: <overtime_pay>"
# - "Total pay: <total_pay>"
# - "Has overtime: true|false"
#
# Validations:
# - hours_worked >= 0
# - hourly_rate > 0
# - En caso de error mostrar: "Error: invalid input"

horas_prueba = [45.0, 40.0, -5.0]
pagos_prueba = [100.0, 100.0, 100.0]

for i in range(3):
    hours_worked = horas_prueba[i]
    hourly_rate = pagos_prueba[i]
    
    print(f"\nInput: Hours={hours_worked}, Rate={hourly_rate}")
    
    if hours_worked < 0 or hourly_rate <= 0:
        print("Error: invalid input")
    else:
        # Puros if basicos para separar horas
        if hours_worked > 40.0:
            regular_hours = 40.0
            overtime_hours = hours_worked - 40.0
            has_overtime = True
        else:
            regular_hours = hours_worked
            overtime_hours = 0.0
            has_overtime = False
            
        regular_pay = regular_hours * hourly_rate
        overtime_pay = overtime_hours * hourly_rate * 1.5
        total_pay = regular_pay + overtime_pay
        
        print(f"Regular pay: {regular_pay}")
        print(f"Overtime pay: {overtime_pay}")
        print(f"Total pay: {total_pay}")
        
        if has_overtime == True:
            print("Has overtime: true")
        else:
            print("Has overtime: false")
        
