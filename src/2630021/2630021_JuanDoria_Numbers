print("Problem 6: Body Mass Index (BMI) and category flag".upper())
"""Description: Calcula el índice de masa corporal (BMI) y utiliza banderas 
# booleanas para categorizar el resultado como bajo peso, normal o sobrepeso.
"""
# Inputs:
# - weight_kg (float)
# - height_m (float)
#
# Outputs:
# - "BMI: <bmi>"
# - "Underweight: true|false"
# - "Normal: true|false"
# - "Overweight: true|false"
#
# Validations:
# - weight_kg > 0.0
# - height_m > 0.0 (esto también previene la división entre cero)
# - En caso de error mostrar "Error: invalid input"

def calculate_bmi(weight_input, height_input):
    try:
        weight_kg = float(weight_input)
        height_m = float(height_input)
    except ValueError:
        print("Error: invalid input")
        return
        
    if weight_kg <= 0.0 or height_m <= 0.0:
        print("Error: invalid input")
        return
        
    bmi = weight_kg / (height_m * height_m)
    
    is_underweight = bmi < 18.5
    is_normal = 18.5 <= bmi < 25.0
    is_overweight = bmi >= 25.0
    
    print(f"BMI: {bmi:.2f}")
    print(f"Underweight: {str(is_underweight).lower()}")
    print(f"Normal: {str(is_normal).lower()}")
    print(f"Overweight: {str(is_overweight).lower()}")
    print()


# Pruebas
calculate_bmi(68, 1.75)   
calculate_bmi(50, 1.70)   
calculate_bmi(85, 1.80)   
calculate_bmi(0, 1.75)    
calculate_bmi(70, -1.5)   
calculate_bmi("abc", 1.8) 

